# Copy this file to .env and fill in your values
# Without ANTHROPIC_API_KEY the system runs in demo mode — everything still works

ANTHROPIC_API_KEY=sk-ant-your-key-here
DEMO_MODE=false

# ── Public demo deployment ──────────────────────────────────
# When true: destructive endpoints (e.g. DELETE /leads/{id}) return 403,
# and the interactive API docs (/docs, /redoc, /openapi.json) are disabled.
PUBLIC_DEMO_MODE=true

# How often (in minutes) the shared demo dataset is wiped and re-seeded
# from the original 12 demo leads. Only runs while PUBLIC_DEMO_MODE=true.
DEMO_RESET_INTERVAL_MINUTES=60

# Frontend origin allowed to call this API (CORS). Comma-separate multiple
# origins if needed, e.g. "https://demo-leadtodeal.example.com,https://www.example.com"
ALLOWED_ORIGIN=https://demo-leadtodeal.example.com
